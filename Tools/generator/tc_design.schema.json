{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tc_design.schema.json",
  "title": "1단계 출력: 요구사항 1건의 TC 설계",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirementId", "testCases"],
  "properties": {
    "requirementId": { "type": "string", "pattern": "^FR-[A-Z]+-\\d{3}$" },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "technique", "priority", "precondition", "steps", "testData", "expected", "evidence"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "technique": { "enum": ["경계값 분석", "동등 분할", "상태 전이", "결정 테이블", "오류 추측", "명세 기반"] },
          "priority": { "enum": ["High", "Medium", "Low"] },
          "precondition": { "type": "string" },
          "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "testData": { "type": "string" },
          "expected": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["quote"],
            "properties": {
              "quote": { "type": "string", "minLength": 2, "description": "기대 결과의 근거가 되는 명세 원문. 검증기가 명세 본문에 그대로 들어 있는지 확인한다." }
            }
          }
        }
      }
    }
  }
}
