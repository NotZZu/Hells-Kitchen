{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exec_plan.schema.json",
  "title": "2단계 출력: 요구사항 1건의 실행 계획(템플릿이 NUnit 으로 바꾼다)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirementId",
    "cases"
  ],
  "properties": {
    "requirementId": {
      "type": "string",
      "pattern": "^FR-[A-Z]+-\\d{3}$"
    },
    "cases": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "pattern",
          "steps"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{2,80}$",
            "description": "C# 메서드 이름"
          },
          "pattern": {
            "enum": [
              "P1",
              "P2",
              "P3",
              "P4",
              "P5",
              "P6",
              "P7",
              "P8"
            ]
          },
          "designIndex": {
            "type": "integer",
            "minimum": 0,
            "description": "1단계 testCases 의 몇 번째 TC 에서 왔는가"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/step"
            }
          }
        }
      }
    },
    "unconvertible": {
      "type": "array",
      "description": "코드로 옮길 수 없는 TC 와 사유. cases 가 비어 있으면 모든 TC 를 여기에 적는다",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "designIndex",
          "reason"
        ],
        "properties": {
          "designIndex": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300
          }
        }
      }
    }
  },
  "$defs": {
    "ident": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]{0,30}$"
    },
    "value": {
      "description": "숫자, 문자열, 불리언, 이전 단계에서 만든 변수 참조, 또는 열거형 이름",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "$ref": "#/$defs/ident"
            },
            "member": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vec3"
          ],
          "properties": {
            "vec3": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enum",
            "name"
          ],
          "properties": {
            "enum": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nameof"
          ],
          "properties": {
            "nameof": {
              "type": "string"
            }
          }
        }
      ]
    },
    "args": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/value"
      },
      "maxItems": 6
    },
    "step": {
      "description": "허용된 동작 어휘. 목록에 없는 op 는 검증기가 거부한다.",
      "oneOf": [
        {
          "title": "create",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "as",
            "type"
          ],
          "properties": {
            "op": {
              "const": "create"
            },
            "as": {
              "$ref": "#/$defs/ident"
            },
            "type": {
              "type": "string",
              "description": "카탈로그에 있는 클래스 이름"
            },
            "fields": {
              "type": "object",
              "description": "공개 필드·프로퍼티 초기값",
              "additionalProperties": {
                "$ref": "#/$defs/value"
              }
            }
          }
        },
        {
          "title": "setField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "target",
            "field",
            "value"
          ],
          "properties": {
            "op": {
              "const": "setField"
            },
            "target": {
              "$ref": "#/$defs/ident"
            },
            "field": {
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/value"
            },
            "backing": {
              "type": "boolean",
              "description": "자동 프로퍼티의 백킹 필드를 쓴다"
            }
          }
        },
        {
          "title": "call",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "target",
            "method"
          ],
          "properties": {
            "op": {
              "const": "call"
            },
            "target": {
              "$ref": "#/$defs/ident"
            },
            "method": {
              "type": "string"
            },
            "args": {
              "$ref": "#/$defs/args"
            },
            "as": {
              "$ref": "#/$defs/ident"
            },
            "static": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "description": "static 일 때 대상 클래스"
            }
          }
        },
        {
          "title": "invokePrivate",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "method"
          ],
          "properties": {
            "op": {
              "const": "invokePrivate"
            },
            "target": {
              "$ref": "#/$defs/ident"
            },
            "method": {
              "type": "string"
            },
            "args": {
              "$ref": "#/$defs/args"
            },
            "as": {
              "$ref": "#/$defs/ident"
            },
            "static": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "description": "static 일 때 대상 클래스"
            }
          }
        },
        {
          "title": "measureDt",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "as"
          ],
          "properties": {
            "op": {
              "const": "measureDt"
            },
            "as": {
              "$ref": "#/$defs/ident"
            }
          },
          "description": "Time.deltaTime 을 읽고 0 이하면 Inconclusive 로 끝낸다(허위 통과 방지)"
        },
        {
          "title": "expectLog",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "pattern"
          ],
          "properties": {
            "op": {
              "const": "expectLog"
            },
            "pattern": {
              "type": "string"
            },
            "level": {
              "enum": [
                "Error",
                "Warning",
                "Log"
              ]
            }
          }
        },
        {
          "title": "expect",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "actual",
            "is",
            "evidence"
          ],
          "properties": {
            "op": {
              "const": "expect"
            },
            "actual": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target"
              ],
              "properties": {
                "target": {
                  "$ref": "#/$defs/ident"
                },
                "member": {
                  "type": "string"
                }
              },
              "description": "member 가 없으면 변수 자체, 있으면 그 공개 프로퍼티·필드"
            },
            "is": {
              "enum": [
                "equal",
                "notEqual",
                "approx",
                "greater",
                "less",
                "greaterOrEqual",
                "lessOrEqual",
                "true",
                "false",
                "null",
                "notNull"
              ]
            },
            "expected": {
              "$ref": "#/$defs/value"
            },
            "expectedMinus": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "dt"
              ],
              "properties": {
                "value": {
                  "$ref": "#/$defs/value"
                },
                "dt": {
                  "$ref": "#/$defs/ident"
                }
              },
              "description": "기대값 = value - dt (신선도처럼 시간에 따라 줄어드는 값)"
            },
            "tolerance": {
              "type": "number",
              "minimum": 0
            },
            "evidence": {
              "type": "string",
              "description": "이 기대값의 근거가 되는 명세 원문"
            }
          }
        }
      ]
    }
  }
}